# =====================================================================
# KEFA AI — .env.example
# Copiar como ".env" y reemplazar los valores por credenciales reales.
# Este archivo NUNCA debe contener secretos reales, solo placeholders.
# =====================================================================

# ============================
# Django / Backend
# ============================
SECRET_KEY=changeme-django-secret-key
DEBUG=True
# ⚠️ NUNCA True en producción
ALLOWED_HOSTS=localhost,127.0.0.1

# El puerto publicado por Docker es configurable (8080 por defecto).
BACKEND_HOST_PORT=8080

# ============================
# PostgreSQL
# ============================
POSTGRES_DB=kefa_ai
POSTGRES_USER=kefa_user
# IMPORTANTE: no agregues POSTGRES_PASSWORD aquí. Docker utiliza
# secrets/postgres_password.txt junto a POSTGRES_PASSWORD_FILE.
# Para ejecutar Django sin Docker, usa backend/.env por separado.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ============================
# JWT / OAuth 2.0
# ============================
# SimpleJWT utiliza SECRET_KEY de Django para firmar, salvo configuración
# explícita de SIGNING_KEY. JWT_SECRET no se consume en la configuración actual.
OAUTH_CLIENT_ID=changeme
OAUTH_CLIENT_SECRET=changeme

# ============================
# CORS (frontend React/Vite)
# ============================
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============================
# Inteligencia Artificial (LLM)
# DECISIÓN PENDIENTE (Biblia sección 5): el equipo aún no eligió proveedor
# final. Se incluyen ambas variables como placeholder. Cuando se decida,
# eliminar la que no se use y documentar la decisión (ver docs/ai/).
# ============================
OPENAI_API_KEY=changeme-openai-api-key
ANTHROPIC_API_KEY=changeme-anthropic-api-key

# ============================
# Telegram
# ============================
TELEGRAM_BOT_TOKEN=changeme-telegram-bot-token

# ============================
# Google Calendar / Google Tasks
# ============================
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback

# ============================
# Notion
# ============================
NOTION_API_KEY=changeme-notion-api-key

# ============================
# n8n
# ============================
N8N_HOST=localhost
N8N_PORT=5678
# Clave usada por n8n para cifrar las credenciales que guarda internamente
# (ej. Google, Notion, si se configuran directamente en n8n). Si se pierde
# o cambia, esas credenciales guardadas quedan inutilizables.
N8N_ENCRYPTION_KEY=changeme-n8n-encryption-key
# URL pública de webhooks de n8n; NO usar como URL interna desde Docker.
# La integración backend → n8n deberá utilizar http://n8n:5678 mediante
# variable separada cuando se implemente el servicio (revisar ADR).
N8N_BASE_URL=http://localhost:5678
# URL interna de callback propuesta para n8n → Backend (ruta aún NO implementada).
N8N_WEBHOOK_CALLBACK_URL=http://backend:8000/api/n8n/callback
