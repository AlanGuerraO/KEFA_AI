# ============================
# Python / Django
# ============================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
db.sqlite3
db.sqlite3-journal
staticfiles/
media/
*.log
.pytest_cache/
.mypy_cache/
htmlcov/
coverage/
.coverage

# ============================
# React / Vite / Node
# ============================
node_modules/
dist/
dist-ssr/
.vite/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ============================
# PostgreSQL
# ============================
pgdata/
*.dump
backups/

# ============================
# Docker
# ============================
docker-compose.override.yml
.docker/

# ============================
# IDE (VSCode se ignora por completo, según decisión del equipo)
# ============================
.vscode/
.idea/
*.iml
*.sublime-workspace
*.sublime-project

# ============================
# Sistema operativo
# ============================
.DS_Store
Thumbs.db
Desktop.ini

# ============================
# Variables de entorno
# Nunca se sube el .env real, solo .env.example
# ============================
.env
.env.*
!.env.example

# ============================
# Secretos y certificados
# Relevante por el uso de OAuth 2.0, JWT y credenciales de
# APIs externas (Google Calendar, Google Tasks, Notion).
# ============================
*.pem
*.key
*.crt
*.p12
secrets.json
credentials.json

# ============================
# Otros
# ============================
*.bak
*.tmp
